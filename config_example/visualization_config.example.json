// Example visualization config. Copy to config/vis_config.json and replace sample paths.
// prealign reads saved pipeline outputs. Global view requires final-frame XML.
{
    // The 2d mode previews tile-local detections without XML.
    "mode": "prealign",
    // "local" shows a tile's final-frame coordinates; "global" places selected tiles
    // on the saved final-frame XML axes.
    "view_space": "local",
    "global_z_start": null,
    // 2d_source: raw=1_2d_raw, filtered=2_2d_filtered (unshifted images).
    // aligned=3_2d_aligned, aligned_filtered=4_2d_filtered (shifted images; runs without
    // 4_2d_filtered, e.g. downstream layout v2, fall back to 3_2d_aligned).
    "2d_source": "filtered",
    // Set a CSV path to save false-negative annotations.
    "fn_ann_path": null,
    // Set a directory to save annotation image crops.
    "fn_crop_dir": null,
    "fn_crop_size": 512,
    // Select the matching sample entry below.
    "active_sample": "example_sample",
    // First displayed slice, zero based.
    "z_start": 0,
    // Maximum number of displayed slices.
    "z_count": 50,

    // Defaults for the Napari Video export dock (start/end are set in the viewer).
    "video_export": {"fps": 10, "output_dir": "exports/videos"},
    // Replace paths to match the detection config and keep frame_channel consistent.
    "samples": {
        "example_sample": {
            "paths": {
                "rfp_dir": "/path/to/brain_sample/561nm",
                "gfp_dir": "/path/to/brain_sample/640nm",
                "sox9_dir": "/path/to/brain_sample/730nm",
                "olig2_dir": "/path/to/brain_sample/488nm",
                "pATHRESULT": "/path/to/brain_sample/detection_results",
                "pATHXML": null
            },
            "pipeline_mode": "pre_align",
            "frame_channel": "RFP",
            "channels_routing": [
                {
                    "id": "GFP",
                    "type": "soma",
                    "dir_key": "gfp_dir",
                    "active": true
                },
                {
                    "id": "RFP",
                    "type": "soma",
                    "dir_key": "rfp_dir",
                    "active": true
                },
                {
                    "id": "Sox9",
                    "type": "tf",
                    "dir_key": "sox9_dir",
                    "active": true
                },
                {
                    "id": "Olig2",
                    "type": "tf",
                    "dir_key": "olig2_dir",
                    "active": true
                }
            ]
        }
    },
    // Null prompts for a tile index; a name or list also works.
    "tile": null,
    "no_images": false,
    // Initial image contrast percentiles.
    "contrast_pct": [
        0.1,
        99.9
    ],
    "show_before": false,
    "show_zlinked": true,
    "show_coloc": false,
    "show_filtered_2d": false,
    "spheres": false,
    "outline_width": 4
}
