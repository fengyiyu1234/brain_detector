{
    // ── 模型权重路径 ──────────────────────────────────────────────────────────
    "models": {
        "yolo_path":       "models/train18_best_0515.pt",
        "cellpose_path":   "models/custom_nuclei_model",
        "stardist_basedir": "models",           // StarDist 模型所在目录（相对项目根目录）
        "stardist_name":    "2D_versatile_fluo" // 目录名，即 models/2D_versatile_fluo/
    },

    // ── 模型输出类别映射 ──────────────────────────────────────────────────────
    "model_classes": {
        "yolo":     {"0": "neuron", "1": "glia"},   // 0=神经元, 1=胶质细胞
        "cellpose": {"0": "nucleus"}                // 0=细胞核
    },

    // ── 通道路由配置 ──────────────────────────────────────────────────────────
    // type "soma" → YOLO 检测细胞体；type "tf" → model "cellpose" 或 "stardist" 均支持
    // active: false 的通道在推理时跳过
    "channels_routing": [
        {"id": "RFP",   "type": "soma", "model": "yolo",     "dir_key": "rfp_dir",   "active": true},
        {"id": "GFP",   "type": "soma", "model": "yolo",     "dir_key": "gfp_dir",   "active": true},
        {"id": "Sox9",  "type": "tf",   "model": "stardist", "dir_key": "sox9_dir",  "active": true},
        {"id": "Olig2", "type": "tf",   "model": "stardist", "dir_key": "olig2_dir",  "active": true}
    ],

    // ── 文件路径 ──────────────────────────────────────────────────────────────

        "paths": {

        "rfp_dir":    "/rsstu/users/a/agrinba/DeepDesign/Fengyi/EGFR_brain/batch4/sample5/numorph_align/aligned/RFP",
        "gfp_dir":    "/rsstu/users/a/agrinba/DeepDesign/Fengyi/EGFR_brain/batch4/sample5/numorph_align/aligned/GFP_15",
        "sox9_dir":   "/rsstu/users/a/agrinba/DeepDesign/Fengyi/EGFR_brain/batch4/sample5/numorph_align/aligned/Sox9",
        "olig2_dir":  "/rsstu/users/a/agrinba/DeepDesign/Fengyi/EGFR_brain/batch4/sample5/numorph_align/aligned/Olig2",
        "pATHRESULT": "/rsstu/users/a/agrinba/DeepDesign/Fengyi/EGFR_brain/batch4/sample5/detection_results_stardist"

    },

    "device": "cuda",               // 推理设备，"cuda" 或 "cpu"

    // ── Pipeline 模式 ──────────────────────────────────────────────────────────
    // "post_align": 在 numorph+TeraStitcher 对齐后的图片上检测（默认行为）
    // "pre_align" : 在未对齐的原始图片上检测，用点云匹配计算通道偏移（替代numorph）
    "pipeline_mode": "post_align",

    // ── Pre-Align 参数（仅 pipeline_mode="pre_align" 时生效）──────────────────
    "pre_align_params": {
        "sample_z_center_count": 50,    // 取z轴中心多少张切片用于点云对齐
        "xy_search_range_px":    30,    // XY方向FFT互相关搜索半径（像素）
        "z_search_range_slices": 5,     // Z方向暴力搜索范围（±切片数）；软上限5，硬上限10（超过10会强制归零）
        "match_distance_px":     15,    // 点云IoU计算时的匹配距离阈值（像素）
        "tile_overlap_pct":      15     // tile重叠率%（仅在无TeraStitcher XML时用于回退grid计算）
    },

    "ENABLE_Z_LINKER": true,        // 是否执行 Z 轴串联；false 时直接输出 2D 结果

    // ── Z-Linker 参数（按通道类型分组）────────────────────────────────────────
    "z_linker": {
        "soma": {
            "iou_thresh":      0.35,    // 相邻 z 层 bbox 匹配所需最小 IoU
            "min_z_layers":    1,       // 判定为真实 3D 细胞的最少 z 层数
            "max_cell_z_span": 5,       // 单个细胞允许跨越的最大 z 层数（防止过度合并）
            "iou_thresh_3d":   0.15,    // soma 跨通道 3D IoU 匹配阈值
            "z_pad_3d":        2        // 3D IoU 匹配时 z 轴方向的扩展层数
        },
        "tf": {
            "iou_thresh":      0.25,    // 细胞核较小，IoU 阈值适当降低
            "min_z_layers":    1,       // 核标记较薄，允许单层即算 3D
            "max_cell_z_span": 3,       // 核一般横跨 2-3 个 z 层
            "gmm_p_thresh":    0.5      // GMM 标注概率阈值
        }
    },

    // ── 检测参数 ──────────────────────────────────────────────────────────────
    "detection_params": {
        // 物理分辨率
        "xy_resolution_um": 0.65,   // XY 像素物理尺寸 (µm/pixel)
        "z_resolution_um":  8,      // Z 轴切片间距 (µm)

        // 检测阈值
        "conf_thresh": 0.3,         // YOLO 置信度阈值
        "nms_iou":     0.3,         // NMS IoU 阈值（去重）

        // 推理 patch 参数
        "xsize": 512,               // 推理 patch 宽 (px)
        "ysize": 512,               // 推理 patch 高 (px)
        "step":  384,               // 滑窗步长 (px)；重叠 = xsize - step = 128 px
        "tILESIZE": 2048,           // TeraStitcher tile 边长 (px)

        // 处理范围
        "sTARTID": null,            // 起始 tile 编号（null = 从头）
        "eNDID":   null,            // 结束 tile 编号（null = 到尾）

        // 图像归一化
        "normalize_PERCENTILE_LOW":  0.1,   // 拉伸下分位数 (%)
        "normalize_PERCENTILE_HIGH": 99.9,  // 拉伸上分位数 (%)

        // Z 轴下采样（加速调试用）
        "DOWNSAMPLE":        false, // 是否跳帧；true 时只处理每隔 DOWNSAMPLE_Z_STEP 的切片
        "DOWNSAMPLE_Z_STEP": 41,    // 跳帧步长（DOWNSAMPLE=true 时生效）

        // 置换检验（共定位统计显著性）
        "n_permutations":   100,    // 随机置换次数；越大越精确，越慢
        "max_soma_sample": 50000,   // 置换时胞体随机采样上限（防止超大样本超时）

        // Cellpose 参数
        "cellpose_batch_size":    32,       // 每次送 GPU 的图片数，L40S 可调到 64
        "cellpose_prob_threshold": 0.5,    // 概率图阈值，越高检测越严格（0.3~0.7）
        "cellpose_3d_anisotropy": null,     // Z/XY 各向异性比（null = 自动估算）
        "cellpose_3d_diameter":   null,     // 细胞直径估计 px（null = 自动检测）

        // StarDist 参数（仅 model="stardist" 通道生效）
        "stardist": {
            "norm_low":         1,      // 归一化下分位数 (%)
            "norm_high":        99.8,   // 归一化上分位数 (%)
            "prob_thresh":      0.5,    // 实例概率阈值（越高检测越严格）
            "nms_thresh":       0.4,    // NMS 重叠阈值
            "n_tiles":          [2, 2], // 推理分块数 [Y, X]，大图用 [2,2] 或 [4,4]
            "nucleus_diam_min": 7,      // 细胞核最小等效直径 (px)，小于此视为噪点
            "nucleus_diam_max": 17      // 细胞核最大等效直径 (px)，大于此视为 bleed-through
        },

        "vISUALIZE_TILE": true      // 保留调试字段，暂未使用
    }

}
